{
  "compilerOptions": {
    "composite": true,
    "outDir": "node_modules/.tsbuild-node",
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
  },
  "include": ["vite.config.ts", "manifest.config.ts", "package.json"]
}
